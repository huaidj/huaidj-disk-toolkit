+static BOOL HuaidjSelectExact(HWND combo, LPARAM value, const char* error)
+{
+    for (int i = 0; i < ComboBox_GetCount(combo); ++i) {
+        if (ComboBox_GetItemData(combo, i) == value) {
+            ComboBox_SetCurSel(combo, i);
+            return TRUE;
+        }
+    }
+    return HuaidjRejectOption(error);
+}
+
+static BOOL HuaidjApplyRequestedOptions(HWND dialog)
+{
+    char label[256];
+    int requested_fs = FS_UNKNOWN;
+    int requested_partition = huaidj_options.partition_scheme == HJ_PT_AUTO ? -1 :
+        (huaidj_options.partition_scheme == HJ_PT_GPT ? PARTITION_STYLE_GPT : PARTITION_STYLE_MBR);
+    BOOL format_only = huaidj_options.format_only;
+    if (!format_only && huaidj_dd_mode) {
+        /* Raw images own their layout; GUI format controls may be disabled. */
+        HuaidjCaptureOptions(FS_UNKNOWN, PARTITION_STYLE_RAW, TT_BIOS, 0, "", FALSE, FALSE);
+        return TRUE;
+    }
+    if (format_only) {
+        if (!HuaidjSelectExact(hBootType, BT_NON_BOOTABLE, "Non-bootable mode is unavailable")) return FALSE;
+        boot_type = BT_NON_BOOTABLE;
+        selection_default = BT_NON_BOOTABLE;
+        CheckDlgButton(dialog, IDC_EXTENDED_LABEL, BST_UNCHECKED);
+    } else if (HAS_WINDOWS(img_report)) {
+        if (!HuaidjSelectExact(hImageOption, IMOP_WIN_STANDARD, "Standard Windows installation mode is unavailable")) return FALSE;
+        imop_win_sel = IMOP_WIN_STANDARD;
+    }
+    if (huaidj_options.filesystem == HJ_FS_FAT32) requested_fs = FS_FAT32;
+    else if (huaidj_options.filesystem == HJ_FS_NTFS) requested_fs = FS_NTFS;
+    else if (huaidj_options.filesystem == HJ_FS_EXFAT) requested_fs = FS_EXFAT;
+    preselected_fs = requested_fs;
+    selected_fs = FS_UNKNOWN;
+    if (requested_partition == PARTITION_STYLE_MBR && SelectedDrive.DiskSize > 2 * TB)
+        return HuaidjRejectOption("MBR above 2 TiB requires an unsupported interactive capacity decision");
+    if (requested_partition >= 0) selected_pt = requested_partition;
+    SetPartitionSchemeAndTargetSystem(FALSE);
+    if (huaidj_options.partition_scheme != HJ_PT_AUTO &&
+        !HuaidjSelectExact(hPartitionScheme, requested_partition, "Requested partition scheme is incompatible with this image/device")) return FALSE;
+    partition_type = (int)ComboBox_GetCurItemData(hPartitionScheme);
+    SetPartitionSchemeAndTargetSystem(TRUE);
+    if (huaidj_options.target_system != HJ_TARGET_AUTO &&
+        !HuaidjSelectExact(hTargetSystem, huaidj_options.target_system == HJ_TARGET_UEFI ? TT_UEFI : TT_BIOS,
+            "Requested target system is incompatible with this image/partition scheme")) return FALSE;
+    target_type = (int)ComboBox_GetCurItemData(hTargetSystem);
+    SetFileSystemAndClusterSize(NULL);
+    if (requested_fs != FS_UNKNOWN && !HuaidjSelectExact(hFileSystem, requested_fs, "Requested filesystem is unavailable for this image/device")) return FALSE;
+    fs_type = (int)ComboBox_GetCurItemData(hFileSystem);
+    selected_fs = fs_type;
+    if (fs_type < 0 || !SetClusterSizes(fs_type)) return HuaidjRejectOption("No valid filesystem/cluster configuration is available");
+    if (huaidj_options.cluster_size && !HuaidjSelectExact(hClusterSize, (LPARAM)huaidj_options.cluster_size,
+        "Requested cluster size is not supported by this filesystem/device")) return FALSE;
+    BOOL large_fat32 = fs_type == FS_FAT32 && SelectedDrive.DiskSize > LARGE_FAT32_SIZE;
+    if (large_fat32 && !huaidj_options.quick_format) return HuaidjRejectOption("The original large FAT32 engine supports quick format only");
+    CheckDlgButton(dialog, IDC_QUICK_FORMAT, huaidj_options.quick_format ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(dialog, IDC_BAD_BLOCKS, BST_UNCHECKED);
+    CheckDlgButton(dialog, IDC_OLD_BIOS_FIXES, BST_UNCHECKED);
+    if (huaidj_options.has_label) {
+        int label_fs = (fs_type == FS_FAT16 || fs_type == FS_FAT32) ? HJ_FS_FAT32 : (fs_type == FS_EXFAT ? HJ_FS_EXFAT : HJ_FS_NTFS);
+        const char* label_error = HuaidjValidateLabel(huaidj_options.volume_label, label_fs);
+        if (label_error) return HuaidjRejectOption(label_error);
+        int bytes = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, huaidj_options.volume_label, -1, NULL, 0, NULL, NULL);
+        if (bytes <= 0 || bytes > 64) return HuaidjRejectOption("Volume label must be valid Unicode and at most 63 UTF-8 bytes for this engine");
+        wchar_t canonical[33];
+        wcscpy_s(canonical, ARRAYSIZE(canonical), huaidj_options.volume_label);
+        if (label_fs == HJ_FS_FAT32) for (wchar_t* c = canonical; *c; ++c) if (*c >= L'a' && *c <= L'z') *c -= L'a' - L'A';
+        SetWindowTextW(hLabel, canonical);
+    } else {
+        if (format_only) SetWindowTextU(hLabel, "USB");
+        GetWindowTextU(hLabel, label, sizeof(label));
+        HuaidjNormalizeAutoLabel(label, fs_type);
+        SetWindowTextU(hLabel, label);
+    }
+    GetWindowTextU(hLabel, label, sizeof(label));
+    if (strlen(label) >= 64) return HuaidjRejectOption("Effective volume label exceeds the native format buffer");
+    strcpy_s(img_report.usb_label, sizeof(img_report.usb_label), label);
+    HuaidjCaptureOptions(fs_type, partition_type, target_type, (DWORD)ComboBox_GetCurItemData(hClusterSize), label,
+        IsChecked(IDC_QUICK_FORMAT), large_fat32);
+    return !HuaidjHasFailed();
+}
